# Salin ke .env lalu isi. Jangan commit .env. Panduan produksi: docs/deploy.md

# --- Database ---
# Lokal (docker compose):
DATABASE_URL="postgresql://paskam:paskam@localhost:5432/paskam?schema=public"
# Supabase (produksi): DATABASE_URL = pooler transaksi (port 6543), DIRECT_URL = koneksi sesi/langsung (port 5432) untuk migrasi.
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"
# DATABASE_POOL_MAX="5"

# --- Zona waktu tampilan (Asia/Jakarta | Asia/Makassar | Asia/Jayapura) ---
APP_TIME_ZONE="Asia/Jakarta"

# --- Storage foto: local (development) | supabase (produksi) ---
STORAGE_DRIVER="local"
STORAGE_DIR="storage"
# SUPABASE_URL="https://<ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="<secret key — HANYA di server, jangan diberi prefix NEXT_PUBLIC_>"
# SUPABASE_STORAGE_BUCKET="paskam"
