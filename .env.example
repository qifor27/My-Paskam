# Salin ke .env lalu isi. Jangan commit .env.
DATABASE_URL="postgresql://paskam:paskam@localhost:5432/paskam?schema=public"

# Zona waktu tampilan (SEMENTARA, Q22). Contoh: Asia/Jakarta, Asia/Makassar, Asia/Jayapura
APP_TIME_ZONE="Asia/Jakarta"

# Storage foto: local (development) | supabase (menyusul, Q23)
STORAGE_DRIVER="local"
STORAGE_DIR="storage"
