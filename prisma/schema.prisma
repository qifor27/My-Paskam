// Skema Sprint 0: hanya entitas yang tidak menunggu open question.
// Entitas modul (laporan_kerja, unit, operator, dll.) ditambahkan di sprint
// masing-masing setelah business rule disetujui. Lihat docs/database.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// URL koneksi ada di prisma.config.ts (Prisma 7).
datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN // Owner
  PENGAWAS
}

enum AuditResult {
  SUCCESS
  FAILURE
}

model User {
  id           String    @id @db.Uuid
  role         Role
  name         String
  // Owner: email/username + password
  email        String?   @unique
  username     String?   @unique
  passwordHash String?   @map("password_hash")
  // Pengawas: kode + PIN
  kodePengawas String?   @unique @map("kode_pengawas")
  pinHash      String?   @map("pin_hash")
  isActive     Boolean   @default(true) @map("is_active")
  /// PIN Laporan Data milik Owner (ADR-018), hash scrypt.
  dataPinHash  String?   @map("data_pin_hash")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdById  String?   @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy           User?            @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers        User[]           @relation("UserCreatedBy")
  laporanSupervised   LaporanKerja[]   @relation("LaporanSupervisor")
  laporanCreated      LaporanKerja[]   @relation("LaporanCreatedBy")
  sparePartSupervised OrderSparePart[] @relation("SparePartSupervisor")
  sparePartCreated    OrderSparePart[] @relation("SparePartCreatedBy")
  planningAssigned    PlanningJob[]    @relation("PlanningSupervisor")
  planningCreated     PlanningJob[]    @relation("PlanningCreatedBy")
  photosUploaded      Photo[]
  sessions            Session[]
  auditLogs           AuditLog[]

  @@map("user")
}

model Session {
  // SHA-256 dari token sesi; token mentah hanya ada di cookie httpOnly.
  id                String    @id
  userId            String    @map("user_id") @db.Uuid
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  userAgent         String?   @map("user_agent")
  /// Laporan Data terbuka sampai waktu ini setelah PIN benar (ADR-018).
  dataUnlockedUntil DateTime? @map("data_unlocked_until") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String?     @map("user_id") @db.Uuid
  action    String
  // Tidak boleh berisi password/PIN/token (PRD §26).
  detail    Json?
  result    AuditResult
  errorId   String?     @map("error_id")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id])

  @@index([action, createdAt])
  @@index([userId, createdAt])
  @@map("audit_log")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("setting")
}

// Brute-force protection (PRD §10). Key: "login:id:<identifier>" atau
// "login:ip:<ip>". Dipisah dari tabel user agar identifier yang tidak
// terdaftar juga dibatasi (mencegah enumerasi).
model RateLimit {
  key         String    @id
  count       Int
  windowStart DateTime  @map("window_start") @db.Timestamptz(3)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(3)

  @@map("rate_limit")
}

// Master data unit (ADR-014: bisa ditambah Owner). Tidak dihapus, hanya
// dinonaktifkan, agar laporan lama tetap merujuk unit yang benar.
model Unit {
  id        String   @id @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  laporan    LaporanKerja[]
  spareParts OrderSparePart[]
  plannings  PlanningJob[]

  @@map("unit")
}

// Laporan Kerja (PRD §14, ADR-014). id dibuat di client dan sekaligus menjadi
// idempotency key (ADR-004): kirim ulang dengan id sama tidak membuat duplikat.
model LaporanKerja {
  id           String    @id @db.Uuid
  tanggal      DateTime  @db.Date
  unitId       String    @map("unit_id") @db.Uuid
  operatorName String    @map("operator_name")
  /// Total jam kerja (HM), 1 angka desimal.
  hmJam        Decimal   @map("hm_jam") @db.Decimal(4, 1)
  /// BBM (Solar) = jumlah, 1 angka desimal (ADR-016).
  bbm          Decimal   @db.Decimal(6, 1)
  lokasi       String
  deskripsi    String
  /// Pengawas yang login saat membuat laporan (tidak diisi manual).
  supervisorId String    @map("supervisor_id") @db.Uuid
  createdById  String    @map("created_by") @db.Uuid
  updatedById  String?   @map("updated_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Soft delete (ADR-014): laporan terhapus tidak tampil, tetap ada untuk audit.
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  unit       Unit @relation(fields: [unitId], references: [id])
  supervisor User @relation("LaporanSupervisor", fields: [supervisorId], references: [id])
  createdBy  User @relation("LaporanCreatedBy", fields: [createdById], references: [id])

  @@index([supervisorId, tanggal])
  @@index([tanggal])
  @@index([unitId, tanggal])
  @@map("laporan_kerja")
}

// Order Spare Part = dokumentasi spare part yang rusak, tanpa status (ADR-016).
model OrderSparePart {
  id           String            @id @db.Uuid
  unitId       String            @map("unit_id") @db.Uuid
  partName     String            @map("part_name")
  /// Nomor part pabrikan (opsional, ADR-017).
  partNumber   String?           @map("part_number")
  /// Jumlah spare part rusak (>= 1, ADR-017).
  quantity     Int               @default(1)
  priority     SparePartPriority @default(SEDANG)
  /// Deskripsi kerusakan.
  kerusakan    String
  lokasi       String
  /// Pengawas yang login saat mencatat (tidak diisi manual).
  supervisorId String            @map("supervisor_id") @db.Uuid
  createdById  String            @map("created_by") @db.Uuid
  updatedById  String?           @map("updated_by") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?         @map("deleted_at") @db.Timestamptz(3)

  unit       Unit @relation(fields: [unitId], references: [id])
  supervisor User @relation("SparePartSupervisor", fields: [supervisorId], references: [id])
  createdBy  User @relation("SparePartCreatedBy", fields: [createdById], references: [id])

  @@index([supervisorId, createdAt])
  @@index([createdAt])
  @@index([unitId, createdAt])
  @@map("order_spare_part")
}

enum SparePartPriority {
  RENDAH
  SEDANG
  TINGGI
}

enum PlanningStatus {
  DIRENCANAKAN
  BERJALAN
  SELESAI
  DIBATALKAN
}

// Planning Job (PRD §16, ADR-017): dibuat Owner, ditugaskan ke satu Pengawas.
model PlanningJob {
  id              String         @id @db.Uuid
  /// Pengawas yang ditugaskan.
  supervisorId    String         @map("supervisor_id") @db.Uuid
  unitId          String         @map("unit_id") @db.Uuid
  namaPekerjaan   String         @map("nama_pekerjaan")
  lokasi          String
  deskripsi       String
  estimasiMulai   DateTime       @map("estimasi_mulai") @db.Date
  estimasiSelesai DateTime       @map("estimasi_selesai") @db.Date
  status          PlanningStatus @default(DIRENCANAKAN)
  /// Waktu aktual, diisi otomatis saat status berubah.
  startedAt       DateTime?      @map("started_at") @db.Timestamptz(3)
  completedAt     DateTime?      @map("completed_at") @db.Timestamptz(3)
  createdById     String         @map("created_by") @db.Uuid
  updatedById     String?        @map("updated_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz(3)

  unit       Unit @relation(fields: [unitId], references: [id])
  supervisor User @relation("PlanningSupervisor", fields: [supervisorId], references: [id])
  createdBy  User @relation("PlanningCreatedBy", fields: [createdById], references: [id])

  @@index([supervisorId, status])
  @@index([status, estimasiMulai])
  @@map("planning_job")
}

enum PhotoModule {
  LAPORAN_KERJA
  ORDER_SPARE_PART
  PLANNING_JOB
}

enum RetentionStatus {
  KEEP
  ACTIVE
  ARCHIVED
  DELETE_PENDING
  DELETED
}

// Metadata foto (PRD §39.2). File ada di storage, bukan di DB.
// Foto diunggah lebih dulu (record_id null), lalu ditautkan saat laporan disimpan.
model Photo {
  id              String          @id @db.Uuid
  module          PhotoModule
  recordId        String?         @map("record_id") @db.Uuid
  storagePath     String          @map("storage_path")
  mimeType        String          @map("mime_type")
  sizeBytes       Int             @map("size_bytes")
  width           Int
  height          Int
  sha256          String
  sortOrder       Int             @default(0) @map("sort_order")
  retentionStatus RetentionStatus @default(ACTIVE) @map("retention_status")
  uploadedById    String          @map("uploaded_by") @db.Uuid
  uploadedAt      DateTime        @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz(3)

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([module, recordId])
  @@index([uploadedById, recordId])
  @@map("photo")
}
